# Copy to .env and adjust. Environment variables override config/config.yaml;
# CLI flags override both. Never put OAuth secrets or tokens in this file.

# SNSYNC_CONFIG=C:\Users\Hp\Documents\SimpleNotes-to-GoogleDrive-Sync\config\config.yaml
# SNSYNC_HOME=C:\Users\Hp\Documents\SimpleNotes-to-GoogleDrive-Sync

# SNSYNC_SCRAPER_COMMAND=simplenotesscraper
# SNSYNC_SCRAPER_ENV_DIR=C:\Users\Hp\Documents\SimpleNotesScraper
# SNSYNC_SCRAPER_TIMEOUT_SECONDS=120

# SNSYNC_GOOGLE_FOLDER_ID=
# SNSYNC_GOOGLE_FOLDER_PATH=Simplenote
# SNSYNC_GOOGLE_CREDENTIALS_FILE=./config/google_credentials.json
# SNSYNC_TOKEN_STORE=auto

# SNSYNC_DELETED_NOTES=keep
# SNSYNC_TITLE_KEYWORDS=[NOTE],[BOOK]
# SNSYNC_LOG_LEVEL=info
