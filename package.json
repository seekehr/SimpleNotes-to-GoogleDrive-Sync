{
  "name": "simplenotes-gdrive-sync",
  "version": "1.0.0",
  "description": "Exports Simplenote notes via SimpleNotesScraper, converts them to DOCX and synchronizes them to Google Drive.",
  "type": "module",
  "bin": {
    "notesync": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@googleapis/drive": "^26.0.2",
    "@napi-rs/keyring": "^2.1.0",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "docx": "^9.9.0",
    "google-auth-library": "^11.2.0",
    "mdast-util-to-string": "^4.0.0",
    "open": "^11.0.4",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
